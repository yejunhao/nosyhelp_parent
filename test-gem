BEGIN;

-- 1. 定义变量（PG 脚本中通常使用临时变量或直接替换）
-- 请将下面的 'YOUR_PROCESS_ID' 替换为实际 ID
DO $$
DECLARE
    target_id TEXT := 'YOUR_PROCESS_ID';
    now_time TIMESTAMP := CURRENT_TIMESTAMP;
BEGIN

    -- ======================================================
    -- 1. 停止定时任务与作业 (Runtime - Physical Delete)
    -- ======================================================
    DELETE FROM ACT_RU_TIMER_JOB WHERE PROCESS_INSTANCE_ID_ = target_id;
    DELETE FROM ACT_RU_JOB WHERE PROCESS_INSTANCE_ID_ = target_id;
    DELETE FROM ACT_RU_DEADLETTER_JOB WHERE PROCESS_INSTANCE_ID_ = target_id;
    DELETE FROM ACT_RU_SUSPENDED_JOB WHERE PROCESS_INSTANCE_ID_ = target_id;

    -- ======================================================
    -- 2. 清理运行时其他关联数据 (Runtime - Physical Delete)
    -- ======================================================
    DELETE FROM ACT_RU_EVENT_SUBSCR WHERE PROC_INST_ID_ = target_id;
    DELETE FROM ACT_RU_VARIABLE WHERE PROC_INST_ID_ = target_id;
    DELETE FROM ACT_RU_TASK WHERE PROC_INST_ID_ = target_id;
    DELETE FROM ACT_RU_IDENTITYLINK WHERE PROC_INST_ID_ = target_id;

    -- 最后删除执行实例
    DELETE FROM ACT_RU_EXECUTION WHERE PROC_INST_ID_ = target_id;

    -- ======================================================
    -- 3. 归档历史记录 (History - Logical Update)
    -- ======================================================
    
    -- 标记流程实例已结束
    UPDATE ACT_HI_PROCINST 
    SET 
        END_TIME_ = now_time, 
        DELETE_REASON_ = 'Manual termination: Upstream data missing',
        -- 计算毫秒数：(结束时间 - 开始时间) 转换为秒后乘 1000
        DURATION_ = EXTRACT(EPOCH FROM (now_time - START_TIME_)) * 1000
    WHERE ID_ = target_id AND END_TIME_ IS NULL;

    -- 标记所有活动节点已结束
    UPDATE ACT_HI_ACTINST 
    SET 
        END_TIME_ = now_time,
        DELETE_REASON_ = 'Cancelled by system',
        DURATION_ = EXTRACT(EPOCH FROM (now_time - START_TIME_)) * 1000
    WHERE PROC_INST_ID_ = target_id AND END_TIME_ IS NULL;

    -- 标记所有人工任务已结束
    UPDATE ACT_HI_TASKINST 
    SET 
        END_TIME_ = now_time,
        DELETE_REASON_ = 'Deleted',
        DURATION_ = EXTRACT(EPOCH FROM (now_time - START_TIME_)) * 1000
    WHERE PROC_INST_ID_ = target_id AND END_TIME_ IS NULL;

END $$;

COMMIT;
