-- 开始事务
BEGIN;

-- 1. 停止流程实例的执行（将其标记为已结束）
UPDATE ACT_RU_EXECUTION
SET SUSPENSION_STATE_ = 2 -- 标记为暂停状态
WHERE PROC_INST_ID_ = (SELECT PROC_INST_ID_ FROM ACT_RU_EXECUTION WHERE PROCESS_DEFINITION_ID_ = ? AND ACTIVE_ = 1);

-- 2. 删除与流程实例关联的定时任务
DELETE FROM ACT_RU_JOB
WHERE EXECUTION_ID_ IN (SELECT ID_ FROM ACT_RU_EXECUTION WHERE PROC_INST_ID_ = ?);

-- 3. 删除与流程实例相关的定时器任务
DELETE FROM ACT_RU_TIMER_JOB
WHERE EXECUTION_ID_ IN (SELECT ID_ FROM ACT_RU_EXECUTION WHERE PROC_INST_ID_ = ?);

-- 4. 更新任务状态，防止其他任务继续执行（如果有的话）
UPDATE ACT_RU_TASK
SET SUSPENSION_STATE_ = 2 -- 暂停任务
WHERE PROC_INST_ID_ = ?;

-- 提交事务
COMMIT;